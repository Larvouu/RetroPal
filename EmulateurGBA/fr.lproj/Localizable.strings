"whatsnew.s1.title" = "La Nintendo 3DS";
"whatsnew.s1.b1" = "Les jeux Nintendo 3DS se jouent désormais dans Retro Pal, gratuitement pour tous : les deux écrans, l'écran tactile, le pad circulaire, et le stick C de la New 3DS sur le stick droit d'une manette.";
"whatsnew.s1.b2" = "Sauvegardes, états de sauvegarde, retour en arrière et jaquettes officielles fonctionnent dès le premier jour. Les jeux qui utilisent la caméra, le micro ou les mouvements utilisent ceux de votre téléphone.";
"whatsnew.s1.b3" = "Codes de triche et skins personnalisés pour la 3DS avec {PRO}, comme sur chaque console.";
"whatsnew.s1.b4" = "RetroAchievements ne prend en charge aucun jeu 3DS : les jeux 3DS n'ont donc pas de succès.";
"whatsnew.s2.title" = "Retro story";
"whatsnew.s2.b1" = "Votre histoire de joueur sur une page : le temps joué, vos jeux les plus joués, vos consoles en anneau, et vos jours de jeu. Votre historique est gardé sur chaque appareil et vous suit grâce à iCloud.";
"whatsnew.s2.b2" = "Des badges marquent les étapes de votre histoire, de votre premier jeu à mille heures. Quand vous en gagnez un, il s'annonce en haut de l'écran, avec son propre son.";
"whatsnew.s2.b3" = "En décembre, votre récap de l'année : quelques écrans à faire défiler, chacun prêt à être partagé en image.";
"whatsnew.s3.title" = "Look et commandes";
"whatsnew.s3.b1" = "La Game Boy, la Game Boy Color, la Game Boy Advance, la Nintendo DS, la Super Nintendo et la NES ont maintenant une vraie croix moulée, à la forme de celle de la console.";
"whatsnew.s3.b2" = "Classique a désormais la même bibliothèque que les autres looks, sur son fond noir uni.";
"whatsnew.s3.b3" = "La page RetroAchievements est plus claire : votre profil et vos derniers succès d'abord, puis vos jeux, et un toucher ouvre la page d'un jeu.";
"whatsnew.s3.b4" = "Sur iPad, la croix et les boutons de chaque console sont désormais en bas, contre les bords, là où reposent vos pouces.";
"whatsnew.s4.title" = "Et aussi";
"whatsnew.s4.b1" = "Importez des jeux depuis des archives .7z, .rar, .tar, .gz et .xz, et plus seulement .zip.";
"whatsnew.s4.b2" = "Les jeux PlayStation et PSP s'importent plus sûrement : fichiers de disque dont les majuscules diffèrent, archives ZIP de plus de 4 Go, et le vrai nom d'un jeu PSP lu dans son EBOOT.";
"whatsnew.s4.b3" = "Un jeu PSP qui plante dans l'émulateur le dit désormais, au lieu de se figer.";
"whatsnew.s4.b4" = "Le Mode Jeu d'iOS s'active quand vous jouez, pour moins de latence avec les manettes Bluetooth et les AirPods.";
"whatsnew.s4.b5" = "Retro Pal demande confirmation avant de supprimer un jeu de la bibliothèque.";
"whatsnew.s4.b6" = "Sur un clavier, 1 et 2 pressent la seconde paire de gâchettes : ZL et ZR sur la 3DS, L2 et R2 sur la PlayStation, Z sur la Nintendo 64.";
"whatsnew.s4.b7" = "Les jeux Super Nintendo, NES, Master System et Game Gear dont le nom porte un accent ou des caractères japonais gardent désormais leurs sauvegardes en jeu.";

