/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Comment fonctionnent les codes de triche";
"guide.cheats.intro" = "Un code est actif dès que vous l'ajoutez. Si rien ne se passe dans le jeu, c'est presque toujours la première étape ci-dessous qui manque.";
"guide.cheats.step1" = "Touchez Parcourir les codes de triche et choisissez-en un. Le code et son nom se remplissent tout seuls, puis touchez Ajouter un code.";
"guide.cheats.step2" = "La plupart des jeux Game Boy Advance et DS ont besoin d'un Master Code, parfois appelé Enable Code, ajouté et activé EN PREMIER. Sans lui, les autres codes ne font absolument rien. Ils sont marqués d'une clé et placés en haut de la liste.";
"guide.cheats.step3" = "Le rond vert à côté d'un code l'active ou le désactive. Gris signifie désactivé.";
"guide.cheats.step4" = "Certains codes ne s'appliquent qu'après avoir quitté puis rejoint une zone, ou au prochain changement d'écran.";
"guide.cheats.step5" = "Les codes sont écrits pour une version précise d'un jeu. Un code d'une autre région ou révision peut ne rien faire, ou se comporter bizarrement.";
"guide.cheats.footer" = "Votre progression est sauvegardée avant l'ajout du premier code : vous pouvez toujours revenir en arrière avec Restaurer la sauvegarde pré-triche.";
"cheats.browse.masterHint" = "Les codes marqués d'une clé doivent être activés avant que les autres fonctionnent.";
"cheats.browse.notFound" = "Ce jeu n'a pas été reconnu d'après son nom de fichier. Cherchez-le ci-dessous.";

"guide.cheats.step6" = "Beaucoup de codes ont besoin d'un appui sur un bouton pour se déclencher, et le nom du code l'indique : par exemple Press SELECT to Restore Time. Ce nom est conservé quand vous ajoutez le code, relisez-le dans votre liste.";

