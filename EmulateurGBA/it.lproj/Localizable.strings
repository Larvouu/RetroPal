/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Come funzionano i trucchi";
"guide.cheats.intro" = "Un codice è attivo appena lo aggiungi. Se nel gioco non succede nulla, quasi sempre manca il primo passo qui sotto.";
"guide.cheats.step1" = "Tocca Sfoglia i trucchi e scegline uno. Il codice e il suo nome si compilano da soli, poi tocca Aggiungi codice.";
"guide.cheats.step2" = "La maggior parte dei giochi Game Boy Advance e DS ha bisogno di un Master Code, a volte chiamato Enable Code, aggiunto e attivato PER PRIMO. Senza, gli altri codici non fanno nulla. Sono segnati con una chiave e stanno in cima alla lista.";
"guide.cheats.step3" = "Il cerchio verde accanto a un codice lo attiva e lo disattiva. Grigio vuol dire spento.";
"guide.cheats.step4" = "Alcuni codici hanno effetto solo dopo essere usciti e rientrati in una zona, o al cambio di schermata.";
"guide.cheats.step5" = "I codici sono scritti per una versione precisa di un gioco. Uno di un'altra regione o revisione può non fare nulla o comportarsi in modo strano.";
"guide.cheats.footer" = "I tuoi progressi vengono salvati prima del primo codice, quindi puoi sempre tornare indietro con Ripristina il salvataggio pre-trucchi.";
"cheats.browse.masterHint" = "I codici segnati con una chiave devono essere attivi perché gli altri funzionino.";
"cheats.browse.notFound" = "Questo gioco non è stato riconosciuto dal nome del file. Cercalo qui sotto.";

"guide.cheats.step6" = "Molti codici si attivano solo premendo un tasto, e il nome del codice dice quale: per esempio Press SELECT to Restore Time. Quel nome viene conservato quando aggiungi il codice, quindi rileggilo nella tua lista.";

