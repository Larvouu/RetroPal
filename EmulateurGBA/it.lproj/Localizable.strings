/* --- What's New, rewritten each release --- */
"whatsnew.s1.title" = "Il Nintendo 3DS";
"whatsnew.s1.b1" = "I giochi Nintendo 3DS ora si giocano in Retro Pal, gratis per tutti: i due schermi, il touch screen, il pad scorrevole e il C-Stick del New 3DS sullo stick destro di un controller.";
"whatsnew.s1.b2" = "Salvataggi, stati di salvataggio, riavvolgimento e copertine ufficiali funzionano dal primo giorno. I giochi che usano la fotocamera, il microfono o il movimento usano quelli del tuo iPhone.";
"whatsnew.s1.b3" = "Trucchi e skin personalizzati per il 3DS con {PRO}, come su ogni console.";
"whatsnew.s1.b4" = "RetroAchievements non supporta nessun gioco 3DS, quindi i giochi 3DS non hanno obiettivi.";
"whatsnew.s2.title" = "Retro story";
"whatsnew.s2.b1" = "La tua storia di giocatore in una pagina: il tempo di gioco, i giochi più giocati, le tue console in un anello e i tuoi giorni di gioco. La cronologia resta su ogni dispositivo e ti segue tramite iCloud.";
"whatsnew.s2.b2" = "I badge segnano le tappe della tua storia, dal primo gioco a mille ore. Quando ne ottieni uno, compare in cima allo schermo, con un suono tutto suo.";
"whatsnew.s2.b3" = "Ogni dicembre, il tuo recap dell'anno: qualche schermata da scorrere, ognuna pronta da condividere come immagine.";
"whatsnew.s3.title" = "Aspetto e comandi";
"whatsnew.s3.b1" = "Game Boy, Game Boy Color, Game Boy Advance, Nintendo DS, Super Nintendo e NES hanno ora una vera croce direzionale modellata, con la forma di quella della console.";
"whatsnew.s3.b2" = "Classico ha ora la stessa libreria degli altri aspetti, sul suo sfondo nero uniforme.";
"whatsnew.s3.b3" = "La pagina RetroAchievements è più chiara: prima il tuo profilo e gli ultimi obiettivi, poi i tuoi giochi, e un tocco apre la pagina di un gioco.";
"whatsnew.s3.b4" = "Su iPad, la croce direzionale e i tasti di ogni console sono ora in basso, contro i bordi, dove poggiano i tuoi pollici.";
"whatsnew.s4.title" = "E inoltre";
"whatsnew.s4.b1" = "Importa i giochi da archivi .7z, .rar, .tar, .gz e .xz, non solo .zip.";
"whatsnew.s4.b2" = "I giochi PlayStation e PSP si importano in modo più affidabile: file del disco con maiuscole diverse, archivi ZIP oltre 4 GB e il vero nome di un gioco PSP letto dal suo EBOOT.";
"whatsnew.s4.b3" = "Un gioco PSP che si blocca nell'emulatore ora lo dice, invece di restare congelato.";
"whatsnew.s4.b4" = "La Modalità Gioco di iOS si attiva quando giochi, per meno ritardo con i controller Bluetooth e gli AirPods.";
"whatsnew.s4.b5" = "Retro Pal chiede conferma prima di eliminare un gioco dalla libreria.";
"whatsnew.s4.b6" = "Con una tastiera, 1 e 2 premono la seconda coppia di tasti dorsali: ZL e ZR sul 3DS, L2 e R2 sulla PlayStation, Z sul Nintendo 64.";
"whatsnew.s4.b7" = "I giochi Super Nintendo, NES, Master System e Game Gear con accenti o caratteri giapponesi nel nome ora conservano i loro salvataggi di gioco.";

