			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aoshuang.game.ps1</string>
				<string>com.provenance.rom.psx</string>
				<string>com.retroarch.cue</string>
				<string>com.retroarch.chd</string>
				<string>com.retroarch.m3u</string>
				<string>com.retroarch.pbp</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Nintendo 64 ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.n64</string>
				<string>public.aoshuang.game.n64</string>
				<string>com.provenance.rom.n64</string>
			</array>
		</dict>
		<!-- The Mega Drive's, read from each app's own Info.plist (Delta, Manic and
		     Provenance on 2026-10-07; RetroArch's current master on 2026-10-08,
		     which declares one type per extension). Three of them also cover
		     `.bin`, which the importer sorts into cartridge or disc by content. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Mega Drive / Genesis ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.genesis</string>
				<string>public.aoshuang.game.md</string>
				<string>com.provenance.rom.genesis</string>
				<string>com.retroarch.md</string>
				<string>com.retroarch.gen</string>
				<string>com.retroarch.smd</string>
			</array>
		</dict>
		<!-- The Master System's and the Game Gear's, read from each app's own
		     Info.plist on 2026-10-09 (Delta declares neither; RetroArch's iOS
		     build declares `.sms` and not `.gg`). Manic's two also cover `.bin`,
		     as its Mega Drive type does, and the importer sorts a `.bin` by
		     content. Provenance's genesis type above claims `.sms` and `.gg` as
		     well; whichever entry a file arrives under, the importer reads the
		     console from its extension. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Master System ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aoshuang.game.ms</string>
				<string>com.provenance.rom.mastersystem</string>
				<string>com.retroarch.sms</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game Gear ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aoshuang.game.gg</string>
				<string>com.provenance.rom.gamegear</string>
			</array>
		</dict>
		<!-- The PSP's: PPSSPP's own `.cso` type, read from its iOS Info.plist
		     (Vendor/ppsspp/ios/PPSSPP-Info.plist, v1.20.4). Its `ppsspp.iso` and
		     `ppsspp.pbp` are left out with the generic types above: they cover
		     every disk image and every PlayStation EBOOT too. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>PSP game</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ppsspp.cso</string>
			</array>
		</dict>
		<!-- Battery saves (.sav, .srm, .mcd), opened from Files into the
		     library, which finds the game they belong to (2026-10-07). No app
		     owns these extensions and every emulator writes them, so we import a
		     type rather than export one, and take Default rank, not Owner: Retro
		     Pal is the app a tap opens only when nothing else claims saves.
		     Manic exports its own save type for the same extensions, listed
		     second at Alternate so a phone with Manic installed still offers us
		     without taking the file from it. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game save</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.save</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game save</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aoshuang.gamesave</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Retro Pal Skin</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.skin</string>
			</array>
		</dict>
