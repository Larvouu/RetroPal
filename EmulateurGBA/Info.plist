				<string>com.retropal.rom.gg</string>
			</array>
		</dict>
		<!-- PSP. Only `.cso`, the PSP's own compressed image, which no other
		     console uses. Its `.iso` is not claimed, for the PlayStation's
		     reason above (every disk image on the device); its `.pbp` arrives
		     under the PlayStation's type, and the importer reads the file to
		     tell the two consoles apart (PSPDiscProbe). -->
		<dict>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>DocIconPSP</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>PSP game</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.rom.psp</string>
			</array>
		</dict>
		<!-- The same games when ANOTHER emulator's type won the file (added
		     2026-10-07). Every emulator exports a type of its own for the same
		     extensions (Delta com.rileytestut.delta.game.*, Manic
		     public.aoshuang.game.*, Provenance com.provenance.rom.*, RetroArch
		     com.retroarch.*), and iOS gives an extension to ONE of them, so on a
		     phone where one of those apps was there first a .gba is that app's
		     type, not ours, and Retro Pal was not offered for it at all. Apple's
		     developer support answers this collision by having apps claim the
		     identifier that already exists rather than one of their own, which
		     is what these entries do, at Alternate rank: Retro Pal is offered (share sheet,
		     Open With) without taking the tap away from the app that owns the
		     type, so the player's first emulator stays their default, and ours
		     is the default wherever we were first (the Owner entries above).
		     Deliberately NOT declared (imported) here: each type exists exactly
		     when its app is installed, which is exactly when it is needed, and
		     declaring them would add our own definition of another app's type.
		     Left out: their generic types (com.provenance.rom also covers .bin,
		     .img, .iso), PSP types that also cover .pbp, and the system's
		     public.m3u-playlist, which is every music playlist. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game Boy Advance ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.gba</string>
				<string>public.aoshuang.game.gba</string>
				<string>com.provenance.rom.gba</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game Boy Color ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.gbc</string>
				<string>public.aoshuang.game.gbc</string>
				<string>com.provenance.rom.gbc</string>
				<string>com.retroarch.gbc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game Boy ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aoshuang.game.gb</string>
				<string>com.provenance.rom.gb</string>
				<string>com.retroarch.gb</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Nintendo DS ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.ds</string>
				<string>public.aoshuang.game.ds</string>
				<string>com.provenance.rom.ds</string>
				<string>com.retroarch.nds</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Super Nintendo ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rileytestut.delta.game.snes</string>
				<string>public.aoshuang.game.snes</string>
				<string>com.provenance.rom.snes</string>
				<string>com.retroarch.sfc</string>
				<string>com.retroarch.smc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>NES ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
