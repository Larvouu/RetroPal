		<!-- PlayStation. ONE entry for the whole family rather than one per
		     extension, because a disc is a game in several possible containers
		     and they all open the same way. Deliberately NOT claimed here:
		     .bin, .iso and .img. Those are generic enough that claiming them
		     would offer Retro Pal for every firmware blob and disk image on the
		     device, which is rude and would train people to ignore the prompt.
		     They are still accepted in the app's own picker, where the user has
		     already said what they are opening. -->
		<dict>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>DocIconPS1</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>PlayStation disc</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.rom.ps1</string>
			</array>
		</dict>
		<!-- Nintendo 64. One entry for the three byte orders a cartridge is
		     dumped in (.z64, .n64, .v64); the core reads all three. -->
		<dict>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>DocIconN64</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Nintendo 64 ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.rom.n64</string>
			</array>
		</dict>
		<!-- Mega Drive. Owned: .gen and the interleaved copier .smd, which no
		     other format uses. A `.bin` dump is not here: `.bin` is a
		     PlayStation disc's extension too, and the importer tells the two
		     apart by content. `.md` is Markdown's extension as well, so it is
		     its own IMPORTED type, offered at Alternate rank with no icon (the
		     next entry): Retro Pal is in the Open menu of a `.md` game without
		     claiming every Markdown note (audit 2026-10-11). -->
		<dict>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>DocIconMD</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Mega Drive / Genesis ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.rom.md</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Mega Drive / Genesis ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.retropal.rom.mdtext</string>
			</array>
		</dict>
		<!-- Master System and Game Gear. One entry each: one extension each,
		     and the core tells the two consoles apart by it. .sg (SG-1000) and
		     .col (ColecoVision), which the same core reads, are not claimed:
		     the app does not carry those consoles. -->
		<dict>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>DocIconSMS</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Master System ROM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
