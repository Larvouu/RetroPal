/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Jak działają kody";
"guide.cheats.intro" = "Kod jest aktywny od razu po dodaniu. Jeśli w grze nic się nie dzieje, prawie zawsze brakuje pierwszego kroku poniżej.";
"guide.cheats.step1" = "Dotknij Przeglądaj kody i wybierz jeden. Kod i jego nazwa wypełnią się same, potem dotknij Dodaj kod.";
"guide.cheats.step2" = "Większość gier na Game Boy Advance i DS wymaga NAJPIERW kodu Master Code, czasem zwanego Enable Code, dodanego i włączonego. Bez niego pozostałe kody nie robią nic. Są oznaczone kluczem i pokazane na górze listy.";
"guide.cheats.step3" = "Zielone kółko obok kodu włącza go i wyłącza. Szare oznacza wyłączony.";
"guide.cheats.step4" = "Niektóre kody działają dopiero po wyjściu i powrocie do obszaru albo przy następnej zmianie ekranu.";
"guide.cheats.step5" = "Kody pisane są pod konkretną wersję gry. Kod z innego regionu albo wydania może nic nie robić lub dziwnie się zachowywać.";
"guide.cheats.footer" = "Twój postęp jest zapisywany przed dodaniem pierwszego kodu, więc zawsze możesz wrócić przez Przywróć zapis sprzed kodów.";
"cheats.browse.masterHint" = "Kody oznaczone kluczem muszą być włączone, żeby pozostałe działały.";
"cheats.browse.notFound" = "Ta gra nie została rozpoznana po nazwie pliku. Wyszukaj ją poniżej.";

"guide.cheats.step6" = "Wiele kodów działa dopiero po wciśnięciu przycisku, a nazwa kodu mówi którego: na przykład Press SELECT to Restore Time. Ta nazwa zostaje zapisana razem z kodem, więc przeczytaj ją na swojej liście.";

