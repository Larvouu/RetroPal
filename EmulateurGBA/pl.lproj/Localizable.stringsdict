<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>prompt.speed.title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@minutes@</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Grałeś %lld minutę na 1,5x</string>
			<key>few</key>
			<string>Grałeś %lld minuty na 1,5x</string>
			<key>many</key>
			<string>Grałeś %lld minut na 1,5x</string>
			<key>other</key>
			<string>Grałeś %lld minuty na 1,5x</string>
		</dict>
	</dict>
	<key>prompt.milestone.title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@minutes@</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Zagrałeś %lld minutę w gry retro</string>
			<key>few</key>
			<string>Zagrałeś %lld minuty w gry retro</string>
			<key>many</key>
			<string>Zagrałeś %lld minut w gry retro</string>
			<key>other</key>
			<string>Zagrałeś %lld minuty w gry retro</string>
		</dict>
	</dict>
</dict>
</plist>
