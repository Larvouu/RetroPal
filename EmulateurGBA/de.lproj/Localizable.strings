/* --- What's New, rewritten each release --- */
"whatsnew.s1.title" = "Ein neuer Look";
"whatsnew.s1.b1" = "Dreh dein iPhone quer: Die Bibliothek wird zu einem Regal aus Covern vor einem bewegten Hintergrund, und Spielseite, RetroAchievements und Einstellungen bekommen denselben Stil.";
"whatsnew.s1.b2" = "Im Hochformat steht dein zuletzt gespieltes Spiel oben, darunter liegt die Liste auf Glas. Den Look änderst du jederzeit: Der Palettenknopf {PALETTE} oben rechts in der Bibliothek, neben dem +, bietet fünf Looks, und Klassisch, wenn du die bisherige Oberfläche bevorzugst.";
"whatsnew.s1.b3" = "Wähle das Cover jedes Spiels: das offizielle Cover, sein RetroAchievements-Bild, deinen letzten Screenshot oder ein Foto.";
"whatsnew.s2.title" = "iPad";
"whatsnew.s2.b1" = "Retro Pal läuft jetzt auf dem iPad, mit allen Konsolen, im Hoch- wie im Querformat, und mit einer Steuerung, die zum großen Bildschirm passt.";
"whatsnew.s2.b2" = "Verkleinerst du das Fenster neben einer anderen App, wechselt die Bibliothek zu ihrer iPhone-Ansicht.";
"whatsnew.s3.title" = "Controller, die als Tastatur erkannt werden";
"whatsnew.s3.b1" = "Ältere Bluetooth-Controller, die iOS als Tastatur erkennt, etwa das 8BitDo Zero, funktionieren jetzt ohne jede Einrichtung, und jede Taste lässt sich in den Einstellungen pro Konsole neu belegen. Kostenlos.";
"whatsnew.s3.b2" = "Auf dem iPhone verschwindet die Touch-Steuerung, solange eine Tastatur verbunden ist; auf dem iPad bleibt sie sichtbar.";
"whatsnew.s4.title" = "Jede Sprache";
"whatsnew.s4.b1" = "Spiele in ZIP-Dateien, deren Name japanische, koreanische oder chinesische Zeichen oder Buchstaben mit Akzent enthält, werden jetzt unter ihrem richtigen Namen importiert.";
"whatsnew.s4.b2" = "Die Uhr des Nintendo DS zeigt das richtige Jahr, egal welchen Kalender dein Gerät verwendet.";
"whatsnew.s5.title" = "Außerdem";
"whatsnew.s5.b1" = "Die Nintendo-DS-Einstellungen findest du jetzt auf der Seite jedes DS-Spiels, und die RetroAchievements-Zeile steht direkt unter den Speicherplätzen.";
"whatsnew.s5.b2" = "Die Leiste der Bibliothek zeigt den Akkustand deines Controllers.";
"whatsnew.s5.b3" = "RetroAchievements-Erfolge funktionieren jetzt auch in PlayStation-Spielen.";
"whatsnew.s5.b4" = "Cheat-Codes: Ein Spiel in der europäischen oder japanischen Fassung findet jetzt seine eigenen Codes, und die Codes des Originalspiels stehen vor denen von Fan-Modifikationen.";

