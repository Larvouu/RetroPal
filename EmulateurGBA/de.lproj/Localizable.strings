"guide.widget.title" = "Ein Widget zum Home-Bildschirm hinzufügen";
"guide.widget.intro" = "Leg deine Spiele als Cover auf den Home-Bildschirm. Ein Tippen öffnet ein Spiel genau dort, wo du aufgehört hast.";
"guide.widget.step1" = "Berühre und halte eine freie Stelle des Home-Bildschirms, bis die Symbole wackeln.";
"guide.widget.step2" = "Tippe oben auf das + und suche nach Retro Pal.";
"guide.widget.step3" = "Wähle ein Widget: „Weiterspielen“ füllt sich selbst mit deinen letzten Spielen, „Ein Spiel“ und „Vier Spiele“ wählst du selbst.";
"guide.widget.step4" = "Platziere es und tippe auf Fertig.";
"guide.widget.step5" = "Für die beiden, die du selbst wählst: Widget berühren und halten, „Widget bearbeiten“ tippen, dann Spiel und Spielstand auswählen.";
"guide.widget.footer" = "Cover erscheinen, sobald du ein Spiel mindestens einmal gestartet hast, und das Widget aktualisiert sich, wenn du Retro Pal verlässt. Eigene Spiele auszuwählen braucht iOS 17 oder neuer; „Weiterspielen“ läuft auf jedem unterstützten iPhone.";
"guide.widget.footer.ipad" = "Cover erscheinen, sobald du ein Spiel mindestens einmal gestartet hast, und das Widget aktualisiert sich, wenn du Retro Pal verlässt. Eigene Spiele auszuwählen braucht iPadOS 17 oder neuer; „Weiterspielen“ läuft auf jedem unterstützten iPad.";

