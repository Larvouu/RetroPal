/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Como funcionam os códigos";
"guide.cheats.intro" = "Um código fica ativo assim que você adiciona. Se nada acontece no jogo, quase sempre falta o primeiro passo abaixo.";
"guide.cheats.step1" = "Toque em Ver códigos e escolha um. O código e o nome são preenchidos sozinhos, depois toque em Adicionar código.";
"guide.cheats.step2" = "A maioria dos jogos de Game Boy Advance e DS precisa de um Master Code, às vezes chamado de Enable Code, adicionado e ligado PRIMEIRO. Sem ele os outros códigos não fazem nada. Eles vêm marcados com uma chave e aparecem no topo da lista.";
"guide.cheats.step3" = "O círculo verde ao lado de um código liga e desliga ele. Cinza significa desligado.";
"guide.cheats.step4" = "Alguns códigos só surtem efeito depois de sair e voltar a uma área, ou na próxima troca de tela.";
"guide.cheats.step5" = "Os códigos são escritos para uma versão específica do jogo. Um código de outra região ou revisão pode não fazer nada, ou se comportar de forma estranha.";
"guide.cheats.footer" = "Seu progresso é salvo antes do primeiro código, então dá sempre para voltar com Restaurar o save anterior aos códigos.";
"cheats.browse.masterHint" = "Os códigos marcados com uma chave precisam estar ligados para os outros funcionarem.";
"cheats.browse.notFound" = "Este jogo não foi reconhecido pelo nome do arquivo. Procure por ele abaixo.";

"guide.cheats.step6" = "Muitos códigos só funcionam ao apertar um botão, e o próprio nome do código diz qual: por exemplo Press SELECT to Restore Time. Esse nome fica salvo quando você adiciona o código, então leia na sua lista.";

