/* --- What's New, rewritten each release --- */
"whatsnew.s1.title" = "Um novo visual";
"whatsnew.s1.b1" = "Vire o celular de lado: a biblioteca vira uma fileira de capas sobre um fundo em movimento, e a página do jogo, o RetroAchievements e os Ajustes ganham o mesmo estilo.";
"whatsnew.s1.b2" = "No modo retrato, o último jogo que você jogou fica no alto e a lista fica sobre um fundo de vidro logo abaixo. O visual muda quando você quiser: o botão da paleta {PALETTE}, no alto à direita da biblioteca, ao lado do +, oferece cinco estilos, e Clássico se você preferir a interface anterior.";
"whatsnew.s1.b3" = "Escolha a capa de cada jogo: a capa oficial, a imagem do RetroAchievements, sua última captura de tela ou uma foto.";
"whatsnew.s2.title" = "iPad";
"whatsnew.s2.b1" = "O Retro Pal agora roda no iPad, com todos os consoles, na vertical e na horizontal, e com controles no tamanho certo para a tela maior.";
"whatsnew.s2.b2" = "Encolha a janela ao lado de outro app e a biblioteca passa para o layout do iPhone.";
"whatsnew.s3.title" = "Controles reconhecidos como teclado";
"whatsnew.s3.b1" = "Controles Bluetooth antigos que o iOS reconhece como teclado, como o 8BitDo Zero, agora funcionam sem configurar nada, e cada tecla pode ser remapeada por console nos Ajustes. Grátis.";
"whatsnew.s3.b2" = "No iPhone, os controles na tela somem enquanto um teclado estiver conectado; no iPad, eles continuam visíveis.";
"whatsnew.s4.title" = "Todos os idiomas";
"whatsnew.s4.b1" = "Jogos em arquivos ZIP cujo nome tem caracteres japoneses, coreanos, chineses ou acentuados agora são importados com o nome certo.";
"whatsnew.s4.b2" = "O relógio do Nintendo DS mostra o ano certo, seja qual for o calendário configurado no seu aparelho.";
"whatsnew.s5.title" = "E também";
"whatsnew.s5.b1" = "Os ajustes do Nintendo DS agora ficam na página de cada jogo de DS, e a linha do RetroAchievements fica logo abaixo dos slots de save rápido.";
"whatsnew.s5.b2" = "A barra da biblioteca mostra o nível da bateria do seu controle.";
"whatsnew.s5.b3" = "As conquistas do RetroAchievements agora funcionam também nos jogos de PlayStation.";
"whatsnew.s5.b4" = "Códigos de cheat: um jogo em versão europeia ou japonesa agora encontra os próprios códigos, e os códigos do jogo original aparecem antes dos de versões modificadas por fãs.";

