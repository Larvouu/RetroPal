/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Så funkar fuskkoder";
"guide.cheats.intro" = "En kod är aktiv så snart du lägger till den. Händer inget i spelet saknas nästan alltid första steget nedan.";
