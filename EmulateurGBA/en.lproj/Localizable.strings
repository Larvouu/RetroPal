/* --- Guide: playing on a TV (AirPlay / HDMI) --- */
"guide.airplay.title" = "Play on your TV with AirPlay";
"guide.airplay.intro" = "Send the game to a television and keep your iPhone as the controller. Works over AirPlay, or with an HDMI adapter.";
"guide.airplay.step1" = "Put your iPhone and your TV on the same Wi-Fi network. With an HDMI adapter, plug it in and skip to step 3.";
"guide.airplay.step2" = "Open Control Centre, tap Screen Mirroring, then choose your TV.";
"guide.airplay.step3" = "Start a game. It fills the television, and your iPhone keeps the controls.";
"guide.airplay.step4" = "On DS, both screens appear on the TV and the touch screen stays on your iPhone.";
"guide.airplay.step5" = "Connect a controller and the on-screen buttons disappear. Only the DS touch screen is still used on the phone.";
"guide.airplay.step6" = "Once your TV is connected, choose how the two DS screens sit on it in Settings, External display.";
"guide.airplay.footer" = "Sound follows the picture to the television over AirPlay. With a controller, the pause menu opens with the pad's own menu button, so you never need to touch the phone.";
"guide.airplay.proNotice" = "Playing on a TV is part of Retro Pal Pro.";
"guide.airplay.proButton" = "Play on my TV";

/* --- Guide: adding a Home Screen widget --- */
"guide.widget.title" = "Add a widget to your Home Screen";
"guide.widget.intro" = "Put your games on the Home Screen as their box art. One tap opens a game straight where you left off.";
"guide.widget.step1" = "Touch and hold an empty spot on the Home Screen until the icons start to jiggle.";
"guide.widget.step2" = "Tap the + at the top of the screen, then search for Retro Pal.";
"guide.widget.step3" = "Choose a widget: “Continue Playing” fills itself with your latest games, “Pick a Game” and “Pick Four Games” let you choose.";
"guide.widget.step4" = "Place it and tap Done.";
"guide.widget.step5" = "For the two you choose yourself: touch and hold the widget, tap Edit Widget, then pick the game and the save it opens.";
"guide.widget.footer" = "Box art appears once you have played a game at least once, and the widget refreshes when you leave Retro Pal. Choosing your own games needs iOS 17 or later; “Continue Playing” works on every supported iPhone.";

