/* --- What's New, rewritten each release --- */
"whatsnew.s1.title" = "The PlayStation";
"whatsnew.s1.b1" = "PlayStation games play in Retro Pal now, and the console is free for everyone.";
"whatsnew.s1.b2" = "Saves, save states, rewind, cheat codes and achievements all work on it from the first day.";
"whatsnew.s1.b3" = "Progress is saved to a memory card, as it was on the console, and it reaches your other devices like every other save.";
"whatsnew.s1.b4" = "It wears its own shell around the game, in portrait and in landscape. {PRO} repaints that pad in your own colours, down to the ink printed on it.";
"whatsnew.s2.title" = "Discs, whatever shape yours are";
"whatsnew.s2.b1" = "A PlayStation game can be one file or a folder of them. Add a .chd, or a .cue with its .bin, or a zip of the whole thing.";
"whatsnew.s2.b2" = "Retro Pal works out which files belong together and adds one game, not fifty.";
"whatsnew.s2.b3" = "A game on several discs becomes one game, even when the discs arrive as separate files, and you change disc from the pause menu without leaving it.";
"whatsnew.s3.title" = "A pad with two sticks";
"whatsnew.s3.b1" = "The on-screen controls carry both analog sticks and the ANALOG button, so analog games work on glass as well as with a controller.";
"whatsnew.s3.b2" = "The left stick moves, the right one looks around, exactly as the games expect.";
"whatsnew.s4.title" = "Cheats";
"whatsnew.s4.b1" = "A saved cheat can be edited now, so fixing one wrong character no longer means typing the whole code again.";
"whatsnew.s5.title" = "Controls";
"whatsnew.s5.b1" = "The on-screen joystick wears the same moulded look as the PlayStation's sticks, in each console's own colours.";
"whatsnew.s5.b2" = "{PRO} lets you choose how far rewind goes: press and hold the rewind button and pick the number of seconds, up to 30.";

