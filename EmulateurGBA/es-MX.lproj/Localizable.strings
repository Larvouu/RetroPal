/* --- Cheat how-to + browser hints --- */
"guide.cheats.title" = "Cómo funcionan los trucos";
"guide.cheats.intro" = "Un código se activa en cuanto lo añades. Si no pasa nada en el juego, casi siempre falta el primer paso de abajo.";
"guide.cheats.step1" = "Toca Buscar trucos y elige uno. El código y su nombre se rellenan solos, luego toca Añadir código.";
"guide.cheats.step2" = "La mayoría de juegos de Game Boy Advance y DS necesitan un Master Code, a veces llamado Enable Code, añadido y activado PRIMERO. Sin él los demás códigos no hacen nada. Van marcados con una llave y aparecen arriba de la lista.";
"guide.cheats.step3" = "El círculo verde junto a un código lo activa y lo desactiva. Gris significa desactivado.";
"guide.cheats.step4" = "Algunos códigos solo surten efecto al salir y volver a entrar en una zona, o al siguiente cambio de pantalla.";
"guide.cheats.step5" = "Los códigos se escriben para una versión concreta de un juego. Uno de otra región o revisión puede no hacer nada o comportarse de forma extraña.";
"guide.cheats.footer" = "Tu progreso se guarda antes de añadir el primer código, así que siempre puedes volver con Restaurar la partida previa a los trucos.";
"cheats.browse.masterHint" = "Los códigos marcados con una llave deben estar activados para que los demás funcionen.";
"cheats.browse.notFound" = "Este juego no se reconoció por su nombre de archivo. Búscalo abajo.";

"guide.cheats.step6" = "Muchos códigos necesitan que presiones un botón para activarse, y el propio nombre del código lo indica: por ejemplo Press SELECT to Restore Time. Ese nombre se conserva al añadir el código, así que léelo en tu lista.";

