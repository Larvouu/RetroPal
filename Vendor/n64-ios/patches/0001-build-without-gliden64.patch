Build the core without GLideN64 (HAVE_GLIDEN64=0), leaving parallel-RDP

GLideN64 is licensed "under the GNU General Public License version 2" with no
"or later" (its LICENSE file, upstream and in this tree). Retro Pal ships
melonDS and MesenCE, which are GPL-3.0, in the same binary, and GPL-2.0-only
code cannot be combined with GPL-3.0 code in one program. Everything else this
build compiles is GPL-2.0-or-later, MIT, CC0 or public domain. angrylion is
already optional upstream (HAVE_THR_AL=0) and stays out for its own licence,
which forbids commercial use.

With HAVE_GLIDEN64=0:
- Makefile.common compiles none of GLideN64's renderer, none of
  custom/GLideN64, no OpenGL at all (glsm, glsym, rglgen, GL_LIB), and not
  the bundled libpng, which only GLideN64 calls (and which cannot build
  against the iOS SDK: it takes TARGET_OS_MAC for classic Mac OS). The
  osal file helpers that live in GLideN64's tree are mupen64plus code under
  GPL-2.0-or-later and the core needs them, so they stay.
- plugin.c turns every request for GLideN64, including libretro.c's own
  fallbacks, into parallel-RDP, in the one function all of them go through,
  and refuses to build if parallel-RDP is not enabled either.
- libretro.c keeps its GLideN64 branches but compiles their OpenGL calls out;
  they are unreachable once plugin.c has redirected the renderer.
- main.c stops loading GLideN64's configuration.
- cxd4 defines DMEM and IMEM itself. It declares them extern and relies on
  GLideN64's N64.cpp for the definitions, and assigns them itself in
  InitiateRSP, so only the definition was borrowed.

HAVE_GLIDEN64 defaults to 1, so every existing build is unchanged.

Retro Pal applies this patch at build time (Vendor/n64-ios/build.sh) rather
than forking the core, so the submodule stays pinned to upstream.

diff --git a/Makefile.common b/Makefile.common
index 72aef3a..a7aa2c1 100644
--- a/Makefile.common
+++ b/Makefile.common
@@ -15,19 +15,30 @@ ZLIB_DIR           = $(ROOT_DIR)/custom/dependencies/libzlib
 
 DYNAREC_USED := 0
 
+# HAVE_GLIDEN64=0 builds the core without the GLideN64 renderer and without
+# any OpenGL: parallel-RDP (Vulkan) is then the only renderer. GLideN64 is
+# licensed GPL-2.0-only, which cannot be combined with GPL-3.0 code in one
+# program. The osal file helpers that sit in GLideN64's tree are mupen64plus
+# code (GPL-2.0-or-later) and stay in the build.
+HAVE_GLIDEN64 ?= 1
+
 INCFLAGS += \
 	-I$(ROOT_DIR)/custom \
 	-I$(ROOT_DIR)/custom/mupen64plus-core \
 	-I$(ROOT_DIR)/custom/android/include \
-	-I$(ROOT_DIR)/custom/GLideN64 \
-	-I$(VIDEODIR_GLIDEN64)/src \
 	-I$(VIDEODIR_GLIDEN64)/src/osal \
 	-I$(CORE_DIR)/src \
 	-I$(CORE_DIR)/src/api \
 	-I$(AUDIO_LIBRETRO_DIR) \
 	-I$(LIBRETRO_COMM_DIR)/include \
-	-I$(LIBRETRO_DIR) \
+	-I$(LIBRETRO_DIR)
+
+ifeq ($(HAVE_GLIDEN64), 1)
+INCFLAGS += \
+	-I$(ROOT_DIR)/custom/GLideN64 \
+	-I$(VIDEODIR_GLIDEN64)/src \
 	-I$(VIDEODIR_GLIDEN64)/src/inc
+endif
 
 MINIZIP_INCFLAGS = -I$(MINIZIP_DIR)
 LIBPNG_INCFLAGS  = -I$(LIBPNG_DIR)
@@ -146,7 +157,10 @@ SOURCES_C += \
 	$(CORE_DIR)/subprojects/md5/md5.c
 COREFLAGS += -I$(CORE_DIR)/subprojects/md5
 
-# libpng
+# libpng, which only GLideN64 uses (its texture packs); nothing else in the
+# build calls it. Left out with GLideN64: this copy also misreads the Apple
+# SDKs' TARGET_OS_MAC as classic Mac OS and asks for <fp.h>, which iOS lacks.
+ifeq ($(HAVE_GLIDEN64), 1)
 ifeq ($(SYSTEM_LIBPNG), 1)
 	CFLAGS += $(shell pkg-config --cflags libpng)
 	LDFLAGS += $(shell pkg-config --libs libpng)
@@ -154,6 +168,7 @@ else
 	INCFLAGS += $(LIBPNG_INCFLAGS)
 	SOURCES_C += $(LIBPNG_SOURCES_C)
 endif
+endif
 
 # Minizip
 ifeq ($(SYSTEM_MINIZIP), 1)
@@ -255,9 +270,11 @@ SOURCES_C += $(LIBRETRO_DIR)/libretro.c \
 	$(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c \
 	$(LIBRETRO_COMM_DIR)/streams/file_stream.c \
 	$(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \
-	$(ROOT_DIR)/custom/mupen64plus-core/api/vidext_libretro.c \
-	$(LIBRETRO_COMM_DIR)/glsm/glsm.c
+	$(ROOT_DIR)/custom/mupen64plus-core/api/vidext_libretro.c
 
+ifeq ($(HAVE_GLIDEN64), 1)
+COREFLAGS += -DHAVE_GLIDEN64
+SOURCES_C += $(LIBRETRO_COMM_DIR)/glsm/glsm.c
 
 SOURCES_CXX   += \
 	$(VIDEODIR_GLIDEN64)/src/Combiner.cpp                                                         \
@@ -390,6 +407,7 @@ SOURCES_CXX   += \
 	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxTexCache.cpp \
 	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxUtil.cpp \
 	$(VIDEODIR_GLIDEN64)/src/RSP_LoadMatrix.cpp
+endif
 
 ifeq ($(HAVE_THR_AL), 1)
 CFLAGS      += -DHAVE_THR_AL
@@ -467,21 +485,24 @@ endif
 
 SOURCES_C += $(LIBRETRO_COMM_DIR)/libco/libco.c
 
+ifeq ($(HAVE_GLIDEN64), 1)
 ifeq ($(platform), $(filter $(platform), rpi3 rpi4 libnx jetson-xavier))
 	SOURCES_CXX += $(VIDEODIR_GLIDEN64)/src/CRC32_ARMV8.cpp
 else
 	SOURCES_CXX += $(VIDEODIR_GLIDEN64)/src/CRC_OPT.cpp
 endif
-
 ifeq ($(HAVE_NEON),1)
 	SOURCES_CXX   += $(VIDEODIR_GLIDEN64)/src/Neon/3DMathNeon.cpp \
 						  $(VIDEODIR_GLIDEN64)/src/Neon/gSPNeon.cpp
+else
+	SOURCES_CXX   += $(VIDEODIR_GLIDEN64)/src/3DMath.cpp
+endif
+endif
 
+ifeq ($(HAVE_NEON),1)
 	SOURCES_ASM += $(LIBRETRO_COMM_DIR)/audio/conversion/float_to_s16_neon.S \
 						$(LIBRETRO_COMM_DIR)/audio/conversion/s16_to_float_neon.S \
 						$(LIBRETRO_COMM_DIR)/audio/resampler/drivers/sinc_resampler_neon.S
-else
-	SOURCES_CXX   += $(VIDEODIR_GLIDEN64)/src/3DMath.cpp
 endif
 
 ifneq ($(platform), $(filter $(platform), ios-arm64 tvos-arm64))
@@ -490,6 +511,7 @@ else
 	SOURCES_C += $(ROOT_DIR)/custom/ios/compat.c
 endif
 
+ifeq ($(HAVE_GLIDEN64), 1)
 ifeq ($(GLES3),1)
 	ifeq ($(platform), $(filter $(platform), ios-arm64 tvos-arm64))
 		GLFLAGS += -DHAVE_OPENGLES -DHAVE_OPENGLES3 -DGLES3
@@ -519,3 +541,7 @@ else
 	SOURCES_C += $(LIBRETRO_COMM_DIR)/glsym/glsym_gl.c
 endif
 SOURCES_C += $(LIBRETRO_COMM_DIR)/glsym/rglgen.c
+else
+# Nothing links against OpenGL without GLideN64.
+GL_LIB :=
+endif
