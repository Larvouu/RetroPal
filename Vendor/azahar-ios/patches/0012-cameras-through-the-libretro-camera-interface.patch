+
+namespace LibRetro::Camera {
+
+/// The private environment command a frontend may answer to learn which 3DS
+/// camera a game is starting: data is a `const char*`, "inner" or "outer".
+/// A frontend that does not know it returns false, and its one camera serves
+/// all three.
+constexpr unsigned ENVIRONMENT_SET_CAMERA_LENS = RETRO_ENVIRONMENT_PRIVATE + 0x3D5;
+
+/// Registers the "libretro" camera with the core and points the three 3DS
+/// cameras at it, when the frontend offers a camera (RETRO_ENVIRONMENT_GET_
+/// CAMERA_INTERFACE). Otherwise the cameras stay blank, as before.
+void Init();
+
+void Shutdown();
+
+} // namespace LibRetro::Camera
