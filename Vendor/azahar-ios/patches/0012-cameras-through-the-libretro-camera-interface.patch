+    28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 30, 30,
+    30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 32,
+    32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 33, 33, 33, 33, 33, 33, 33, 33, 33, 33, 33, 33, 34,
+    34, 34, 34, 34, 34, 34, 34, 34, 34, 34, 34, 35, 35, 35, 35, 35, 35, 35, 35, 35, 35, 35, 35, 35,
+    36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 37, 37, 37, 37, 37, 37, 37, 37, 37, 37, 37, 37,
+    38, 38, 38, 38, 38, 38, 38, 38, 38, 38, 38, 38, 39, 39, 39, 39,
+};
+
+static constexpr int V(int r, int g, int b) {
+    return V_R[r] - V_G[g] - V_B[b];
+}
+} // namespace YuvTable
+
+std::mutex frame_mutex;
+std::vector<u32> frame_pixels;
+unsigned frame_width = 0;
+unsigned frame_height = 0;
+
+retro_camera_callback camera_cb{};
+bool camera_available = false;
+int capturing = 0;
+
+void RETRO_CALLCONV OnFrame(const uint32_t* buffer, unsigned width, unsigned height,
+                            size_t pitch) {
+    if (!buffer || !width || !height || pitch < width * 4) {
+        return;
+    }
+    std::lock_guard lock{frame_mutex};
+    frame_pixels.resize(static_cast<std::size_t>(width) * height);
+    for (unsigned y = 0; y < height; y++) {
+        std::memcpy(frame_pixels.data() + static_cast<std::size_t>(y) * width,
+                    reinterpret_cast<const u8*>(buffer) + y * pitch, width * 4);
+    }
+    frame_width = width;
+    frame_height = height;
+}
+
+class LibRetroCamera final : public ::Camera::CameraInterface {
+public:
+    explicit LibRetroCamera(std::string lens_, Service::CAM::Flip flip)
+        : lens(std::move(lens_)) {
+        SetFlip(flip);
+    }
+
+    ~LibRetroCamera() override {
+        StopCapture();
+    }
+
+    void StartCapture() override {
+        if (started || !camera_available) {
+            return;
+        }
+        started = true;
+        LibRetro::SetCameraLens(lens.c_str());
+        if (capturing++ == 0 && camera_cb.start) {
+            camera_cb.start();
+        }
+    }
+
+    void StopCapture() override {
+        if (!started) {
+            return;
+        }
+        started = false;
+        if (--capturing == 0 && camera_cb.stop) {
+            camera_cb.stop();
+        }
+    }
+
+    void SetResolution(const Service::CAM::Resolution& resolution) override {
+        width = resolution.width;
+        height = resolution.height;
+    }
+
+    void SetFlip(Service::CAM::Flip flip) override {
+        using Service::CAM::Flip;
+        flip_horizontal = flip == Flip::Horizontal || flip == Flip::Reverse;
+        flip_vertical = flip == Flip::Vertical || flip == Flip::Reverse;
+    }
+
+    void SetEffect(Service::CAM::Effect) override {}
+
+    void SetFormat(Service::CAM::OutputFormat format) override {
+        output_rgb = format == Service::CAM::OutputFormat::RGB565;
+    }
+
+    void SetFrameRate(Service::CAM::FrameRate) override {}
+
+    std::vector<u16> ReceiveFrame() override {
+        const int w = std::max(width, 0), h = std::max(height, 0);
+        std::vector<u32> rgb(static_cast<std::size_t>(w) * h, 0);
+        {
+            std::lock_guard lock{frame_mutex};
+            if (frame_width && frame_height && w && h) {
+                // Filled, not fitted: the picture covers the whole frame and
+                // its longer side is cropped, centred (citra_qt's
+                // KeepAspectRatioByExpanding).
+                const double scale = std::max(static_cast<double>(w) / frame_width,
+                                              static_cast<double>(h) / frame_height);
+                const double ox = (frame_width * scale - w) / 2.0;
+                const double oy = (frame_height * scale - h) / 2.0;
+                for (int y = 0; y < h; y++) {
+                    const int ty = flip_vertical ? h - 1 - y : y;
+                    const auto sy = std::min<unsigned>(
+                        static_cast<unsigned>((y + oy + 0.5) / scale), frame_height - 1);
+                    for (int x = 0; x < w; x++) {
+                        const int tx = flip_horizontal ? w - 1 - x : x;
+                        const auto sx = std::min<unsigned>(
+                            static_cast<unsigned>((x + ox + 0.5) / scale), frame_width - 1);
+                        rgb[static_cast<std::size_t>(ty) * w + tx] =
+                            frame_pixels[static_cast<std::size_t>(sy) * frame_width + sx];
+                    }
+                }
+            }
+        }
+        std::vector<u16> out(static_cast<std::size_t>(w) * h);
+        if (output_rgb) {
+            for (std::size_t i = 0; i < rgb.size(); i++) {
+                const u32 p = rgb[i];
+                out[i] = static_cast<u16>(((p >> 8) & 0xF800) | ((p >> 5) & 0x07E0) |
+                                          ((p >> 3) & 0x001F));
+            }
+            return out;
+        }
+        // YUV422: two pixels share one U and one V (citra_qt's Rgb2Yuv).
+        auto dest = out.begin();
+        bool write = false;
+        int py = 0, pu = 0, pv = 0;
+        for (const u32 p : rgb) {
+            const int r = (p >> 16) & 0xFF, g = (p >> 8) & 0xFF, b = p & 0xFF;
+            const int y = YuvTable::Y(r, g, b);
+            const int u = YuvTable::U(r, g, b);
+            const int v = YuvTable::V(r, g, b);
+            if (write) {
+                pu = (pu + u) / 2;
+                pv = (pv + v) / 2;
+                *(dest++) =
+                    static_cast<u16>(std::clamp(py, 0, 0xFF) | (std::clamp(pu, 0, 0xFF) << 8));
+                *(dest++) =
+                    static_cast<u16>(std::clamp(y, 0, 0xFF) | (std::clamp(pv, 0, 0xFF) << 8));
+            } else {
+                py = y;
+                pu = u;
+                pv = v;
+            }
+            write = !write;
+        }
+        return out;
+    }
+
+    bool IsPreviewAvailable() override {
+        return camera_available;
+    }
+
+private:
+    std::string lens;
+    int width = 0;
+    int height = 0;
+    bool output_rgb = false;
+    bool flip_horizontal = false;
+    bool flip_vertical = false;
+    bool started = false;
+};
+
+class LibRetroCameraFactory final : public ::Camera::CameraFactory {
+public:
+    std::unique_ptr<::Camera::CameraInterface> Create(const std::string& config,
+                                                      const Service::CAM::Flip& flip) override {
+        return std::make_unique<LibRetroCamera>(config, flip);
+    }
+};
+
+} // namespace
+
+void Init() {
+    camera_cb = {};
+    camera_cb.caps = 1 << RETRO_CAMERA_BUFFER_RAW_FRAMEBUFFER;
+    camera_cb.frame_raw_framebuffer = OnFrame;
+    camera_available = LibRetro::GetCameraInterface(&camera_cb);
+    if (!camera_available) {
+        return;
+    }
+    ::Camera::RegisterFactory("libretro", std::make_unique<LibRetroCameraFactory>());
+    using namespace Service::CAM;
+    Settings::values.camera_name[OuterRightCamera] = "libretro";
+    Settings::values.camera_config[OuterRightCamera] = "outer";
+    Settings::values.camera_name[InnerCamera] = "libretro";
+    Settings::values.camera_config[InnerCamera] = "inner";
+    Settings::values.camera_name[OuterLeftCamera] = "libretro";
+    Settings::values.camera_config[OuterLeftCamera] = "outer";
+}
+
+void Shutdown() {
+    if (capturing > 0 && camera_cb.stop) {
+        camera_cb.stop();
+    }
+    capturing = 0;
+    std::lock_guard lock{frame_mutex};
+    frame_pixels.clear();
+    frame_width = frame_height = 0;
+}
+
+} // namespace LibRetro::Camera
