+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -147,6 +147,12 @@
 }
 
 PipelineCache::~PipelineCache() {
+    // The cache is going away (a shutdown, or a state load, which rebuilds the renderer):
+    // builds no worker has started are dropped instead of waited for. A state load right
+    // after a boot otherwise waited for every pipeline the boot had queued from the disk
+    // cache, each a whole Metal compile on MoltenVK (seconds on a phone).
+    pipeline_workers.CancelPending();
+    shader_workers.CancelPending();
     pipeline_workers.WaitForRequests();
     shader_workers.WaitForRequests();
     SaveDriverPipelineDiskCache();
@@ -180,8 +186,12 @@
 
     LOG_INFO(Render_Vulkan, "Switching pipeline cache to title_id={:016X}", title_id);
 
-    // Save current driver cache, update program ID and load the new driver cache
-    SaveDriverPipelineDiskCache();
+    // Save current driver cache, update program ID and load the new driver cache. Not when
+    // there is no current one yet (the cache was just made, after a state load): saving it
+    // would overwrite the title-0 file with an empty cache.
+    if (curr_disk_cache) {
+        SaveDriverPipelineDiskCache();
+    }
     SetProgramID(title_id);
     LoadDriverPipelineDiskCache(stop_loading, nullptr);
 
