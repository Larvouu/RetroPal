+/// A read-only stream buffer over bytes that already exist, so a decompressed
+/// state is deserialized where it lies. The istringstream it replaces took a
+/// std::string copy of the bytes and then a copy of that string: three copies
+/// of an uncompressed state (296 MB for a New 3DS game) alive at once.
+class ByteViewBuffer : public std::streambuf {
+public:
+    ByteViewBuffer(const u8* data, std::size_t size) {
+        char* begin = const_cast<char*>(reinterpret_cast<const char*>(data));
+        setg(begin, begin, begin + size);
+    }
+
+protected:
+    pos_type seekoff(off_type off, std::ios_base::seekdir dir,
+                     std::ios_base::openmode which) override {
+        if (!(which & std::ios_base::in)) {
+            return pos_type(off_type(-1));
+        }
+        char* target = dir == std::ios_base::beg   ? eback() + off
+                       : dir == std::ios_base::cur ? gptr() + off
+                                                   : egptr() + off;
+        if (target < eback() || target > egptr()) {
+            return pos_type(off_type(-1));
+        }
+        setg(eback(), target, egptr());
+        return pos_type(target - eback());
+    }
+
+    pos_type seekpos(pos_type pos, std::ios_base::openmode which) override {
+        return seekoff(off_type(pos), std::ios_base::beg, which);
+    }
+};
+
+/// A write stream buffer that appends to a vector, so a serialized state is
+/// compressed from where it was written. The ostringstream it replaces was
+/// then copied whole by str(): two copies of an uncompressed state alive at
+/// once, on top of the stream's own growth. The vector is reserved at the
+/// size the last state had, so it does not double its way up each time.
+class ByteSinkBuffer : public std::streambuf {
+public:
+    explicit ByteSinkBuffer(std::size_t expected) {
+        bytes.reserve(expected);
+    }
+
+    std::vector<u8> bytes;
+
+protected:
+    int_type overflow(int_type ch) override {
+        if (traits_type::eq_int_type(ch, traits_type::eof())) {
+            return traits_type::not_eof(ch);
+        }
+        bytes.push_back(static_cast<u8>(traits_type::to_char_type(ch)));
+        return ch;
+    }
+
+    std::streamsize xsputn(const char* data, std::streamsize count) override {
+        bytes.insert(bytes.end(), reinterpret_cast<const u8*>(data),
+                     reinterpret_cast<const u8*>(data) + count);
+        return count;
+    }
+
+    pos_type seekoff(off_type off, std::ios_base::seekdir dir,
+                     std::ios_base::openmode which) override {
+        // Only "where am I" is answered: the archive asks it, it never seeks.
+        if (off == 0 && dir == std::ios_base::cur && (which & std::ios_base::out)) {
+            return pos_type(off_type(bytes.size()));
+        }
+        return pos_type(off_type(-1));
+    }
+};
+
+/// The uncompressed size of the last state serialized, so the next one is
+/// reserved in one go.
+std::size_t last_state_size = 0;
+
+/// What the first state is reserved at, before one has been measured: the
+/// emulated memories it carries (MemorySystem::Impl::serialize), which are
+/// nearly all of it, and 40 MB for the rest (30.5 MB in a New 3DS state of
+/// Majora's Mask 3D, so it does not grow). Unreserved, the vector
+/// doubled to 512 MB for a 296 MB state and held the old 256 MB block while
+/// it copied: 768 MB at that instant.
+std::size_t ExpectedStateSize() {
+    const bool n3ds = Settings::values.is_new_3ds.GetValue();
+    return Memory::VRAM_SIZE + (n3ds ? Memory::FCRAM_N3DS_SIZE : Memory::FCRAM_SIZE) +
+           (n3ds ? Memory::N3DS_EXTRA_RAM_SIZE : 0) + Memory::DSP_RAM_SIZE + 0x02800000;
+}
