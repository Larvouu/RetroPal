+    // Ask the driver if it can give us the pipeline quickly. Not when the caller would
+    // rather skip the draw (async_never_waits): on MoltenVK this "quick" probe can still
+    // compile a whole Metal pipeline state on the emulation thread, and holds the driver
+    // cache's lock while a worker compiles, so the game stops either way.
+    const bool probe = wait_built || !Settings::values.async_never_waits;
+    if (probe && !shaders_pending && instance.IsPipelineCreationCacheControlSupported() &&
+        Build(true)) {
         return true;
     }
 
