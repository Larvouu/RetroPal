+void System::SaveStateRaw(std::vector<u8>& buffer) const {
+    buffer.clear();
+    ByteSinkBuffer sink{0};
+    sink.bytes.swap(buffer);
+    {
+        std::ostream stream{&sink};
+        oarchive oa{stream};
+        oa&* this;
+    }
+    last_state_size = sink.bytes.size();
+    sink.bytes.swap(buffer);
+}
+
+bool System::LoadStateRaw(std::span<const u8> state) {
+    ByteViewBuffer view{state.data(), state.size()};
+    std::istream stream{&view};
+    iarchive ia{stream};
+    ia&* this;
+    return true;
+}
