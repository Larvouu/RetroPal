+// A rewind's states: the state as the archive writes it, without the header and
+// the compression retro_serialize adds (System::SaveStateRaw). Not part of the
+// libretro API; a frontend that knows them calls them by name. The capture
+// writes into the frontend's own buffer, whose capacity is kept between calls.
+// Not a format to store: valid only for this build and the running title.
+extern "C" RETRO_API bool retro_ctr_rewind_capture(std::vector<u8>* buffer) {
+    auto& system = Core::System::GetInstance();
+    if (!buffer || !system.IsPoweredOn() || !DrainAsyncOperations(system)) {
+        return false;
+    }
+    try {
+        system.SaveStateRaw(*buffer);
+        return !buffer->empty();
+    } catch (const std::exception& e) {
+        LOG_ERROR(Frontend, "Error taking a rewind state: {}", e.what());
+        return false;
+    }
+}
+
+extern "C" RETRO_API bool retro_ctr_rewind_restore(const void* data, size_t size) {
+    auto& system = Core::System::GetInstance();
+    if (!data || !size || !system.IsPoweredOn() || !DrainAsyncOperations(system)) {
+        return false;
+    }
+    try {
+        return system.LoadStateRaw({static_cast<const u8*>(data), size});
+    } catch (const std::exception& e) {
+        LOG_ERROR(Frontend, "Error restoring a rewind state: {}", e.what());
+        return false;
+    }
+}
