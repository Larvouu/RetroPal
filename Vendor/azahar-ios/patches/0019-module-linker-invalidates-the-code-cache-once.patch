+void System::EndDeferredCacheInvalidation() {
+    ASSERT(deferred_invalidation_depth > 0);
+    if (--deferred_invalidation_depth > 0 || deferred_invalidations.empty()) {
+        return;
+    }
+    // Sorted and merged, so each backend sees each byte once.
+    auto& ranges = deferred_invalidations;
+    std::sort(ranges.begin(), ranges.end());
+    std::size_t merged = 0;
+    for (std::size_t i = 1; i < ranges.size(); ++i) {
+        if (ranges[i].first <= ranges[merged].second) {
+            ranges[merged].second = std::max(ranges[merged].second, ranges[i].second);
+        } else {
+            ranges[++merged] = ranges[i];
+        }
+    }
+    ranges.resize(merged + 1);
+    for (const auto& cpu : cpu_cores) {
+        cpu->InvalidateCacheRanges(ranges);
+    }
+    ranges.clear();
+}
