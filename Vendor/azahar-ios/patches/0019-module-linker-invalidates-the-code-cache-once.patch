+    /// The same for several ranges ([start, end), sorted, not overlapping) in ONE
+    /// walk of the cache: each live block is tested against the first range
+    /// that ends after its start (a binary search).
+    void InvalidateRanges(const std::vector<std::pair<u32, u32>>& ranges) {
+        if (ranges.empty()) {
+            return;
+        }
+        for (size_t i = 0; i < CACHE_SIZE; ++i) {
+            if (tags_[i] == INVALID_TAG) {
+                continue;
+            }
+            const u32 start_pc = blocks_[i].start_pc;
+            const u32 end_pc = blocks_[i].end_pc;
+            const auto it = std::upper_bound(
+                ranges.begin(), ranges.end(), start_pc,
+                [](u32 pc, const std::pair<u32, u32>& range) { return pc < range.second; });
+            if (it != ranges.end() && it->first < end_pc) {
+                tags_[i] = INVALID_TAG;
+                blocks_[i].inst_count = 0;
+                blocks_[i].chain_target = nullptr;
+            }
+        }
+    }
