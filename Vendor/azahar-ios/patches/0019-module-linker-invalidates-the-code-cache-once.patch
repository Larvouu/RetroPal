+/// Holds the code-cache invalidations of one RO call back until it returns: the
+/// CRO linker invalidates every 4-byte relocation it writes, thousands per
+/// module (Pokemon Sun's FieldRo: 11,000), and on FastInterp each one walked the
+/// whole block cache on every core (0.5 s of frozen game at a field load on an
+/// A16). The call runs to completion before any guest instruction executes, so
+/// invalidating at its end is as safe as invalidating at each write.
+class DeferredCacheInvalidation {
+public:
+    explicit DeferredCacheInvalidation(Core::System& system) : system(system) {
+        system.BeginDeferredCacheInvalidation();
+    }
+    ~DeferredCacheInvalidation() {
+        system.EndDeferredCacheInvalidation();
+    }
+    DeferredCacheInvalidation(const DeferredCacheInvalidation&) = delete;
+    DeferredCacheInvalidation& operator=(const DeferredCacheInvalidation&) = delete;
+
+private:
+    Core::System& system;
+};
