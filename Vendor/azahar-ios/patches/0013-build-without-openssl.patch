Build without OpenSSL or LibreSSL (CITRA_NO_OPENSSL)

Azahar links LibreSSL into its core for the emulated HTTP service's https
requests (cpp-httplib's SSL client), and calls OpenSSL's RAND_bytes in two
services. LibreSSL carries the OpenSSL and SSLeay licences, whose advertising
clause is not compatible with the GPL, and Azahar's licence has no exception
for it.

This adds the CMake option CITRA_NO_OPENSSL (default OFF, so a build that does
not set it is unchanged). With it on, no TLS library is built or linked;
cpp-httplib is built without CPPHTTPLIB_OPENSSL_SUPPORT, so the 3DS's HTTP
service keeps plain http and an https request completes as a failed request,
as one that could not connect does; the random bytes of ssl:C's
GenerateRandomData and of AM's ticket encryption come from Crypto++'s
operating-system generator (OS_GenerateRandomBlock).

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -133,6 +133,7 @@
 CMAKE_DEPENDENT_OPTION(ENABLE_ROOM_STANDALONE "Enable generating a standalone dedicated room executable" ON "ENABLE_ROOM" OFF)
 
 option(ENABLE_WEB_SERVICE "Enable web services (telemetry, etc.)" ON)
+option(CITRA_NO_OPENSSL "Build without OpenSSL or LibreSSL (no https in the emulated HTTP service)" OFF)
 option(ENABLE_SCRIPTING "Enable RPC server for scripting" ON)
 CMAKE_DEPENDENT_OPTION(ENABLE_SCRIPTING_SYNC "Run scripting RPC requests that access emulated state on the emulation thread, in sync with the core" ON "ENABLE_SCRIPTING" OFF)
 option(ENABLE_GDBSTUB "Enable GDB stub for emulated applications" ON)
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -304,7 +304,13 @@
 endif()
 
 # OpenSSL
-if (USE_SYSTEM_OPENSSL)
+# CITRA_NO_OPENSSL: no TLS library at all. httplib is then built without SSL
+# support, so the 3DS's HTTP service serves plain http only and an https
+# request fails as a network error; the random bytes OpenSSL gave come from
+# Crypto++'s operating-system generator.
+if (CITRA_NO_OPENSSL)
+    set(OPENSSL_LIBRARIES "")
+elseif (USE_SYSTEM_OPENSSL)
     find_package(OpenSSL 1.1)
     set(OPENSSL_LIBRARIES OpenSSL::SSL OpenSSL::Crypto)
 else()
@@ -345,8 +351,10 @@
     target_include_directories(httplib INTERFACE ./httplib)
     target_disable_warnings(httplib)
 endif()
-target_compile_options(httplib INTERFACE -DCPPHTTPLIB_OPENSSL_SUPPORT)
-target_link_libraries(httplib INTERFACE ${OPENSSL_LIBRARIES})
+if (NOT CITRA_NO_OPENSSL)
+    target_compile_options(httplib INTERFACE -DCPPHTTPLIB_OPENSSL_SUPPORT)
+    target_link_libraries(httplib INTERFACE ${OPENSSL_LIBRARIES})
+endif()
 
 if (UNIX AND NOT APPLE)
     add_subdirectory(gamemode EXCLUDE_FROM_ALL)
