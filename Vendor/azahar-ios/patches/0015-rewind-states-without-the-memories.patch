+
+    /// Whether the page `n` after `start` continues its run: the same
+    /// attribute, and the same backing at the next page's offset or no
+    /// backing at all for either.
+    bool SameRun(std::size_t start, std::size_t n) const {
+        const MemoryRef& first = pointers.refs[start];
+        const MemoryRef& next = pointers.refs[start + n];
+        if (next.Backing() != first.Backing() || attributes[start + n] != attributes[start]) {
+            return false;
+        }
+        return !first.Backing() || next.Offset() == first.Offset() + n * CITRA_PAGE_SIZE;
+    }
+
+    /// Runs of (first page, page count, backing, offset of the first page),
+    /// each backing archived once per run, so the archive's object tracking
+    /// still keeps every backing's identity.
+    template <class Archive>
+    void SerializeCompact(Archive& ar) {
+        if constexpr (Archive::is_saving::value) {
+            u32 runs = 0;
+            for (std::size_t i = 0; i < PAGE_TABLE_NUM_ENTRIES;) {
+                std::size_t n = 1;
+                while (i + n < PAGE_TABLE_NUM_ENTRIES && SameRun(i, n)) {
+                    n++;
+                }
+                i += n;
+                runs++;
+            }
+            ar << runs;
+            for (std::size_t i = 0; i < PAGE_TABLE_NUM_ENTRIES;) {
+                std::size_t n = 1;
+                while (i + n < PAGE_TABLE_NUM_ENTRIES && SameRun(i, n)) {
+                    n++;
+                }
+                const u32 start = static_cast<u32>(i), count = static_cast<u32>(n);
+                const MemoryRef& first = pointers.refs[i];
+                const u64 offset = first.Offset();
+                const PageType type = attributes[i];
+                ar << start << count << first.Backing() << offset << type;
+                i += n;
+            }
+        } else {
+            u32 runs = 0;
+            ar >> runs;
+            for (u32 r = 0; r < runs; r++) {
+                u32 start = 0, count = 0;
+                std::shared_ptr<BackingMem> backing;
+                u64 offset = 0;
+                PageType type{};
+                ar >> start >> count >> backing >> offset >> type;
+                if (u64{start} + count > PAGE_TABLE_NUM_ENTRIES) {
+                    throw std::runtime_error("rewind page table run out of range");
+                }
+                for (u32 k = 0; k < count; k++) {
+                    pointers.refs[start + k] =
+                        backing ? MemoryRef(backing, offset + u64{k} * CITRA_PAGE_SIZE)
+                                : MemoryRef{};
+                    attributes[start + k] = type;
+                }
+            }
+        }
+    }
 };
 
