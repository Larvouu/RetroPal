# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/

# macOS
.DS_Store
*.swp
*~

# Swift Package Manager
.build/
Packages/

# ROMs (never commit game files)
*.gba
*.gbc
*.gb
*.nds
*.sfc
*.smc
*.nes
*.zip

# PlayStation discs. Same rule as the cartridges above, and listed BEFORE any
# PS1 work could put one here: a disc image is the largest game file the app
# handles, so an accidental commit is also the most expensive to undo. `.bin`
# and `.iso` are deliberately included even though they are generic extensions,
# because in THIS repo the only thing that would carry them is a game.
*.chd
*.cue
*.bin
*.iso
*.img
*.pbp
*.m3u
*.mdf
*.toc
*.cbn
*.sbi
# Memory cards, which hold save data exactly as a .sav does.
*.mcd

# Save-state compatibility fixtures. A save state is a dump of the running
# game's memory, so it carries the same content as the ROM above it and follows
# the same rule. The fixtures therefore stay LOCAL: whoever has them gets the
# guard, everyone else (and the public GPL repo) gets the test's own no-op.
# The capture procedure lives beside them, and stays local for the same reason.
EmulateurGBATests/Fixtures/SaveStateCompat/**/*.state
EmulateurGBATests/Fixtures/SaveStateCompat/**/*.sav
EmulateurGBATests/Fixtures/SaveStateCompat/*.state

# Compiled emulator cores (built on the Mac by Vendor/*-ios/build.sh, never
# committed: they are large, host-specific, and the public repo must ship the
# core SOURCE as a submodule rather than a prebuilt binary).
Vendor/*-ios/lib/

# Personal / non-project files (kept locally, never committed)
ressources/
